<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>dev.fpl.mycelium-https</string>
<key>ProgramArguments</key><array><string>/usr/local/libexec/mycelium-https-forwarder</string><string>--target</string><string>127.0.0.1:8443</string></array>
<key>UserName</key><string>nobody</string>
<key>Sockets</key><dict><key>HTTPS</key><dict>
<key>SockNodeName</key><string>192.0.2.10</string>
<key>SockServiceName</key><integer>443</integer>
<key>SockFamily</key><string>IPv4</string>
<key>SockType</key><string>stream</string>
<key>SockProtocol</key><string>TCP</string>
</dict></dict>
<key>StandardErrorPath</key><string>/var/log/mycelium-https-forwarder.log</string>
<key>ThrottleInterval</key><integer>5</integer>
</dict></plist>

[Unit]
Description=Mount the one-time fungOS QEMU claim envelope
ConditionPathExists=!/var/lib/mycelium/pki/node.pem
After=systemd-udev-trigger.service
Before=fungos-first-contact.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/fungos-mount-claim-envelope
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target

#!/bin/sh
set -eu

environment=$1
grep -qx 'PROFILE=fungos-qemu' "$environment" || {
  echo "unexpected fungOS first-contact profile" >&2
  exit 1
}

# The envelope service staged the claim in tmpfs and unmounted its transport.

exec /usr/local/bin/mycelium setup \
  --claim-file /run/fungos-first-contact/claim \
  --path /var/lib/mycelium \
  --system-service

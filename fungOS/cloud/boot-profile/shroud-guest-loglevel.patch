+fn firecracker_boot_args(root_vfs_tag: Option<&str>, log_level: Option<&str>) -> Result<String> {
+    // Keep errors and warnings on the serial console, not every informational
+    // or debug printk. Operators can restore the exact old mode with `debug`.
+    let level = log_level.unwrap_or("5");
+    anyhow::ensure!(
+        level == "debug" || (level.len() == 1 && matches!(level.as_bytes()[0], b'0'..=b'7')),
+        "SHROUD_GUEST_KERNEL_LOG_LEVEL must be a single digit 0..7 or debug"
+    );
+    let verbosity = if level == "debug" {
+        "debug".to_owned()
+    } else {
+        format!("loglevel={level}")
+    };
+    Ok(format!(
+        "console=ttyS0 reboot=k panic=1 pci=off init=/init {verbosity}{}",
+        root_vfs_tag
+            .map(|tag| format!(" shroud_root_tag={tag}"))
+            .unwrap_or_default()
+    ))
+}

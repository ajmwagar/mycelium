index 0000000..4ffc04b
--- /dev/null
+++ b/crates/canvas/src/background_store.rs
@@ -0,0 +1,133 @@
+//! Local, content-addressed background bytes. Workspace documents retain identity,
+//! not source filenames; originals can move or disappear after import.
+use sha2::{Digest, Sha256};
+use std::{
+    fs,
+    io::{Read, Write},
+    path::{Path, PathBuf},
+};
+const LIMIT: u64 = 128 * 1024 * 1024;
+fn path(root: &Path, digest: &str) -> Result<PathBuf, String> {
+    if digest.len() != 64
+        || !digest
+            .bytes()
+            .all(|b| b.is_ascii_hexdigit() && !b.is_ascii_uppercase())
+    {
+        return Err("invalid background digest".into());
+    }
+    Ok(root.join(digest))
+}
+pub fn read(root: &Path, digest: &str) -> Result<Vec<u8>, String> {
+    let path = path(root, digest)?;
+    let metadata = fs::symlink_metadata(&path).map_err(|e| e.to_string())?;
+    if !metadata.is_file() || metadata.len() == 0 || metadata.len() > LIMIT {
+        return Err("background must be a bounded non-symlink regular file".into());
+    }
+    let mut bytes = Vec::new();
+    fs::File::open(path)
+        .map_err(|e| e.to_string())?
+        .take(LIMIT + 1)
+        .read_to_end(&mut bytes)
+        .map_err(|e| e.to_string())?;
+    if bytes.len() as u64 > LIMIT || format!("{:x}", Sha256::digest(&bytes)) != digest {
+        return Err("background content digest mismatch".into());
+    }
+    Ok(bytes)
+}
+pub fn import(root: &Path, source: &Path, digest: &str) -> Result<(), String> {
+    let destination = path(root, digest)?;
+    let metadata = fs::symlink_metadata(source).map_err(|e| e.to_string())?;
+    if !metadata.is_file() || metadata.len() == 0 || metadata.len() > LIMIT {
+        return Err("background source must be bounded regular file".into());
+    }
+    let mut bytes = Vec::new();
+    fs::File::open(source)
+        .map_err(|e| e.to_string())?
+        .take(LIMIT + 1)
+        .read_to_end(&mut bytes)
+        .map_err(|e| e.to_string())?;
+    if bytes.len() as u64 > LIMIT || format!("{:x}", Sha256::digest(&bytes)) != digest {
+        return Err("background changed during import".into());
+    }
+    fs::create_dir_all(root).map_err(|e| e.to_string())?;
+    if !fs::symlink_metadata(root)
+        .map_err(|e| e.to_string())?
+        .is_dir()
+    {
+        return Err("background store must be a non-symlink directory".into());
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        fs::set_permissions(root, fs::Permissions::from_mode(0o700)).map_err(|e| e.to_string())?;
+    }
+    if destination.exists() {
+        read(root, digest)?;
+        return Ok(());
+    }
+    let temporary = root.join(format!(
+        ".import-{}-{}",
+        std::process::id(),
+        std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .map_err(|e| e.to_string())?
+            .as_nanos()
+    ));
+    let mut options = fs::OpenOptions::new();
+    options.write(true).create_new(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.mode(0o600);
+    }
+    let result = (|| {
+        let mut file = options.open(&temporary).map_err(|e| e.to_string())?;
+        file.write_all(&bytes).map_err(|e| e.to_string())?;
+        file.sync_all().map_err(|e| e.to_string())?;
+        // Never replace an existing object, even during racing imports.
+        match fs::hard_link(&temporary, &destination) {
+            Ok(()) => {}
+            Err(e) if e.kind() == std::io::ErrorKind::AlreadyExists => {
+                read(root, digest)?;
+            }
+            Err(e) => return Err(e.to_string()),
+        }
+        #[cfg(unix)]
+        fs::File::open(root)
+            .and_then(|file| file.sync_all())
+            .map_err(|e| e.to_string())?;
+        Ok(())
+    })();
+    let cleanup = fs::remove_file(&temporary);
+    result?;
+    cleanup.map_err(|e| e.to_string())
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn survives_source_removal_and_rejects_corruption() {
+        let dir = tempfile::tempdir().unwrap();
+        let source = dir.path().join("original");
+        let root = dir.path().join("assets");
+        fs::write(&source, b"image bytes").unwrap();
+        let digest = format!("{:x}", Sha256::digest(b"image bytes"));
+        import(&root, &source, &digest).unwrap();
+        import(&root, &source, &digest).unwrap();
+        fs::remove_file(source).unwrap();
+        assert_eq!(read(&root, &digest).unwrap(), b"image bytes");
+        fs::write(root.join(&digest), b"tampered").unwrap();
+        assert!(read(&root, &digest).is_err());
+    }
+    #[test]
+    fn rejects_missing_unsafe_and_symlink_assets() {
+        let dir = tempfile::tempdir().unwrap();
+        assert!(read(dir.path(), "../bad").is_err());
+        assert!(read(dir.path(), &"a".repeat(64)).is_err());
+        #[cfg(unix)]
+        {
+            std::os::unix::fs::symlink("/etc/passwd", dir.path().join("a".repeat(64))).unwrap();
+            assert!(read(dir.path(), &"a".repeat(64)).is_err());
+        }
+    }
+}

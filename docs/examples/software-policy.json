{
  "schema_version": 1,
  "automatic": {
    "enabled": false,
    "minimum_cache_age_secs": 900,
    "rollout_window_secs": 1800,
    "retry_backoff_secs": 3600
  },
  "rules": [
    {
      "name": "base-mesh",
      "selector": {},
      "packages": [
        { "name": "unibus", "channel": "stable" }
      ]
    },
    {
      "name": "raspberry-pi-media",
      "selector": { "all": ["node.raspberry-pi"] },
      "packages": [
        { "name": "isochrone", "channel": "stable" }
      ]
    },
    {
      "name": "accelerated-compute",
      "selector": { "all": ["resource.gpu"] },
      "packages": [
        { "name": "umie", "channel": "stable" },
        { "name": "yggdrasil", "channel": "stable" }
      ]
    },
    {
      "name": "assistant-nodes",
      "selector": { "all": ["role.jarvis"] },
      "packages": [
        { "name": "jarvis", "channel": "stable" },
        { "name": "dock", "channel": "stable" }
      ]
    },
    {
      "name": "shroud-workers",
      "selector": { "all": ["role.shroud"] },
      "packages": [
        { "name": "shroud", "channel": "stable" }
      ]
    }
  ]
}
